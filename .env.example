# ── Server ────────────────────────────────────────────
# Local thử nghiệm: 8433 (tránh trùng backend Thi247 :8080)
# VPS sau reverse proxy: 8080 + JUDGE_BIND=127.0.0.1
SERVER_PORT=8080
JUDGE_BIND=0.0.0.0

# ── Database ──────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=judgedb
DB_USER=judge
DB_PASSWORD=change_me_in_production

# ── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Judge engine ──────────────────────────────────────
JUDGE_WORKERS=4
JUDGE_WORK_BASE=/tmp/judge
JUDGE_QUEUE_KEY=judge:queue
JUDGE_TESTCASE_BASE_PATH=/data/problems

# ── Sandbox images (override to use private registry) ─
JUDGE_LANG_CPP_IMAGE=judge-cpp:1
JUDGE_LANG_JAVA_IMAGE=judge-java:1
JUDGE_LANG_PYTHON_IMAGE=judge-python:1

# ── Webhook signing ───────────────────────────────────
# Secret used to HMAC-sign result webhooks. Leave empty for the legacy protocol
# (HMAC keyed with the callback URL). Required when connecting to Thi247 as a grader.
JUDGE_WEBHOOK_SECRET=
